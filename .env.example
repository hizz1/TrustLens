# Copy to .env in the project root; backend reads it regardless of working directory.
TRUSTLENS_DATA_DIR=data
TRUSTLENS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Phase 2 limits: 100 MiB, 10 minutes, 120 seconds per tool invocation.
TRUSTLENS_MAX_UPLOAD_BYTES=104857600
TRUSTLENS_MAX_MEDIA_SECONDS=600
TRUSTLENS_SUBPROCESS_TIMEOUT_SECONDS=120
TRUSTLENS_FFMPEG_PATH=ffmpeg
TRUSTLENS_FFPROBE_PATH=ffprobe
# Phase 3: requests use local checkpoint files only. Download explicitly via the helper.
TRUSTLENS_VISUAL_ENABLED=true
TRUSTLENS_VISUAL_MODEL_DIR=models/visual
TRUSTLENS_VISUAL_DEVICE=auto
TRUSTLENS_VISUAL_BATCH_SIZE=4
# UniFD for the AI-generated video option. Download once using download_unifd_model.py.
TRUSTLENS_UNIFD_ENABLED=true
TRUSTLENS_UNIFD_MODEL_DIR=models/unifd
TRUSTLENS_UNIFD_DEVICE=auto
TRUSTLENS_UNIFD_BATCH_SIZE=4
# Public demo credential, intentionally published by the repository owner. Keep API calls server-side.
TRUSTLENS_BITMIND_API_KEY=bitmind-0b5773f0-c404-11f1-9042-bda5ebaf98dd:13429519
TRUSTLENS_BITMIND_TIMEOUT_SECONDS=60
TRUSTLENS_BITMIND_MAX_UPLOAD_BYTES=10000000
